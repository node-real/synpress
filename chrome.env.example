# Chrome for Testing 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# Chrome for Testing 版本
# 默认: 140.0.7339.185
CHROME_FOR_TESTING_VERSION=140.0.7339.185

# 是否使用 Chrome for Testing
# 设置为 false 将使用系统 Chrome (可能不支持扩展加载)
# 默认: true
USE_CHROME_FOR_TESTING=true

# MetaMask 相关配置
# 是否跳过 MetaMask 安装 (如果手动安装了 MetaMask)
SKIP_METAMASK_INSTALL=false

# 是否跳过 MetaMask 设置
SKIP_METAMASK_SETUP=false

# MetaMask 版本
METAMASK_VERSION=11.15.0

# 网络配置
NETWORK_NAME=goerli
# NETWORK_NAME=mainnet
# NETWORK_NAME=sepolia

# 自定义网络配置 (可选)
# RPC_URL=https://your-rpc-url.com
# CHAIN_ID=1
# SYMBOL=ETH
# BLOCK_EXPLORER=https://etherscan.io
# IS_TESTNET=false

# 钱包配置
# SECRET_WORDS="word1 word2 word3 ..."
# PRIVATE_KEY=0x...

# 其他配置
# CI=true
# HEADLESS_MODE=false
# BASE_URL=http://localhost:3000
